{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskpress.dev/schema/content.schema.json",
  "title": "deskpress pack content",
  "description": "The content of a pack: days, places, people, alerts, documents, sheets. Keys are canonical English; every value may be in any language. Unknown keys are allowed everywhere on purpose: the shell renders them as cards, and that is a feature, not a fallback.",
  "type": "object",
  "required": ["days"],
  "properties": {
    "days": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/day" }
    },
    "places": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/place" }
    },
    "people": {
      "type": "array",
      "items": { "$ref": "#/$defs/person" }
    },
    "alerts": {
      "type": "array",
      "items": { "$ref": "#/$defs/alert" }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "climate": {
      "type": "object",
      "properties": {
        "units": { "enum": ["metric", "imperial"] },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "place": { "$ref": "#/$defs/id", "description": "Missing: the whole pack." },
              "month": { "type": "integer", "minimum": 1, "maximum": 12 },
              "date": { "$ref": "#/$defs/date", "description": "A date beats a month." },
              "high": { "type": "number" },
              "low": { "type": "number" },
              "rain": { "type": "number", "minimum": 0, "maximum": 100 },
              "sunrise": { "$ref": "#/$defs/time" },
              "sunset": { "$ref": "#/$defs/time" },
              "summary": { "type": "string" }
            }
          }
        }
      }
    },
    "sheets": {
      "type": "object",
      "description": "Anything else. Any tree here becomes a sheet: bookings, phrases, budget, packing lists, contacts. With no sheets key at all, every root branch the shell does not know becomes a sheet.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^$" },
    "stamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$" },
    "moment_type": {
      "description": "Thirteen values. Each one decides which cards the moment view assembles, and nothing else.",
      "enum": ["visit", "train", "driving", "walking", "meal", "event", "flight", "parking", "lodging", "night", "morning", "transfer", "free"]
    },
    "block": {
      "description": "A list of two or three elements: a time, a text, and an optional map. An empty time is a note about the whole day.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/time" },
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/block_meta" }
      ],
      "items": false
    },
    "block_meta": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/moment_type" },
        "place": { "$ref": "#/$defs/id" },
        "for": {
          "description": "Who this block is for. It is left out of the day while somebody else holds the phone.",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "array", "items": { "$ref": "#/$defs/id" } }]
        },
        "guide": { "$ref": "#/$defs/id" },
        "until": { "$ref": "#/$defs/time" },
        "zone": { "type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)?$|^UTC$", "description": "IANA. The clock of this block's time. The day's zone if missing." },
        "until_zone": { "type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)?$|^UTC$", "description": "IANA. The clock of until, like a flight's arrival. The block's zone if missing." },
        "locked": { "type": "boolean", "description": "An hour that cannot move: a booked train, a timed entry." },
        "language": { "type": "string", "description": "Which branch of the phrase sheets applies here." }
      },
      "additionalProperties": true
    },
    "day": {
      "type": "object",
      "required": ["date", "title"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "title": { "type": "string", "minLength": 1 },
        "who": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "zone": { "type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)?$|^UTC$", "description": "IANA. The day's own clock: today and the block times are read there. The pack's timezone if missing." },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "fixed": {
          "description": "On a day with options: the blocks that happen whatever gets chosen. The only ones written to the calendar up front.",
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        },
        "options": {
          "description": "Two or more closed alternatives. Not a list of ideas: each one is a plan you would be happy with.",
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        },
        "decision": { "$ref": "#/$defs/decision" }
      },
      "additionalProperties": true,
      "dependentRequired": { "options": ["decision"] }
    },
    "option": {
      "type": "object",
      "required": ["id", "name", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "recommended": { "type": "boolean", "description": "At most one per day. Until somebody chooses, the app behaves as this one and says so." },
        "cost": { "type": "string" },
        "why": { "type": "string" },
        "consequence": { "type": "string", "description": "What choosing this does to the rest of the pack, in one line." },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
        "requires": {
          "description": "This option only exists if an earlier day was decided a certain way.",
          "type": "object",
          "required": ["date", "option"],
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "option": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["when"],
      "properties": {
        "when": { "$ref": "#/$defs/date", "description": "The night the app asks, once. Must fall before the day itself." },
        "at": { "$ref": "#/$defs/time" },
        "decides": {
          "description": "Other dates whose options depend on this answer.",
          "type": "array",
          "items": { "$ref": "#/$defs/date" }
        },
        "question": { "type": "string", "description": "What the choose screen asks." }
      },
      "additionalProperties": true
    },
    "place": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "If absent the shell uses the id with underscores turned into spaces, and the validator warns." },
        "kind": { "type": "string", "description": "Free prose. Never used to choose a view." },
        "address": { "type": "string", "description": "The street address. A calendar event at this place gets it after the name, so the calendar can offer the route." },
        "at": {
          "description": "Coordinates and radius. Present means the shell can build a geofence for this place.",
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "radius_m": { "type": "number", "minimum": 25, "maximum": 20000, "default": 100 }
          },
          "additionalProperties": false
        },
        "safe": { "type": "boolean", "description": "A kid session may run here." },
        "guide": {
          "description": "The script for the child a block here names as its guide. Every key is optional.",
          "type": "object",
          "properties": {
            "facts": { "type": "array", "items": { "type": "string" }, "description": "What to tell the family." },
            "question": { "type": "string" },
            "answer": { "type": "string", "description": "Shown after a tap." },
            "challenge": { "type": "string" }
          },
          "additionalProperties": false
        },
        "during": {
          "description": "The content of a moment at this place. Unknown keys inside become cards.",
          "type": "object",
          "properties": { "type": { "$ref": "#/$defs/moment_type" } },
          "additionalProperties": true
        },
        "parking": { "type": "object", "additionalProperties": true },
        "in_order": { "type": "boolean", "default": false, "description": "Joins the points with a position on the map, in their order." },
        "points": {
          "description": "In kid mode the list is filtered to points that have for_kids; the map shows every point with an at. May also sit inside during, where many packs already keep it.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1 },
              "what": { "type": "string" },
              "why": { "type": "string" },
              "for_kids": { "type": "string" },
              "at": {
                "description": "Where the point is outdoors, for the place's map. No radius.",
                "type": "object",
                "required": ["lat", "lon"],
                "properties": {
                  "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                  "lon": { "type": "number", "minimum": -180, "maximum": 180 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          }
        },
        "verified": { "$ref": "#/$defs/date", "description": "When somebody last checked these facts. Never renders as a card." }
      },
      "additionalProperties": true
    },
    "person": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "adult": { "type": "boolean", "default": true, "description": "Decides the mode. Not a setting anyone can flip." },
        "theme": { "type": "string", "description": "Theme family in the theme file." }
      },
      "additionalProperties": true
    },
    "alert": {
      "type": "object",
      "required": ["id", "severity", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "severity": {
          "description": "A budget, not a label. critical shows above the answer; low only in the alerts sheet.",
          "enum": ["critical", "high", "medium", "low"]
        },
        "at": {
          "description": "When the thing happens. A date alone means the whole day.",
          "anyOf": [{ "$ref": "#/$defs/stamp" }, { "$ref": "#/$defs/date" }]
        },
        "time": { "$ref": "#/$defs/time", "description": "Used when at is only a date." },
        "notify_from": {
          "description": "When it starts showing.",
          "anyOf": [{ "$ref": "#/$defs/stamp" }, { "$ref": "#/$defs/date" }]
        },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "action": { "type": "string" },
        "see": { "type": "string", "description": "A path reference into the pack." }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": ["id", "title", "file"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "for": { "$ref": "#/$defs/id", "description": "Person id. Documents are grouped by it, one card each." },
        "file": { "type": "string", "description": "Relative to pack.files. Opens full screen, at maximum brightness, with no network." },
        "fields": {
          "description": "Label -> value. Shown on the card, in this order.",
          "type": "object",
          "additionalProperties": { "type": ["string", "number"] }
        },
        "call": {
          "description": "Label -> number. Buttons that come before the file.",
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[+]?[0-9 ().-]+$" }
        }
      },
      "additionalProperties": true
    }
  }
}
